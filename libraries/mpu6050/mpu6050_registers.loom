Module MPU6050_Registers
Block Global
    Declares
        MPU6050_REG_WHO_AM_I : Constant Signed_64 = 0x75
        MPU6050_REG_PWR_MGMT_1 : Constant Signed_64 = 0x6B
        MPU6050_REG_CONFIG : Constant Signed_64 = 0x1A
        MPU6050_REG_SMPLRT_DIV : Constant Signed_64 = 0x19
        MPU6050_REG_GYRO_CONFIG : Constant Signed_64 = 0x1B
        MPU6050_REG_ACCEL_CONFIG : Constant Signed_64 = 0x1C
        MPU6050_REG_ACCEL_XOUT_H : Constant Signed_64 = 0x3B
        MPU6050_REG_INT_STATUS : Constant Signed_64 = 0x3A
    End Global
