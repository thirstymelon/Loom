Module SSD1306_Graphics
Import SSD1306
use SSD1306

# Fill or clear an inclusive rectangle; coordinates are clipped to the screen.
Block SSD1306_Fill_Rect Takes
    X : Signed_64
    Y : Signed_64
    Width : Signed_64
    Height : Signed_64
    On : Boolean
    Produces Boolean
    Declares
        Col : Signed_64
        Row : Signed_64
    Implements
        If (((Width < 0) Or (Width > 128)) Or ((Height < 0) Or (Height > 64)))
            SSD1306_Internal_Fail(1)
        End If
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        If (((X < -128) Or (X > 128)) Or ((Y < -64) Or (Y > 64)))
            SSD1306_Internal_Fail(1)
        End If
        Row = Y
        Loop while (Row < (Y + Height))
            Col = X
            Loop while (Col < (X + Width))
                If (((Col >= 0) And (Col < SSD1306_WIDTH)) And ((Row >= 0) And (Row < SSD1306_HEIGHT)))
                    If (SSD1306_Pixel(Col, Row, On) == False)
                        SSD1306_Internal_Fail(1)
                    End If
                End If
                Col = Col + 1
            End Loop
            Row = Row + 1
        End Loop
        Give True
End SSD1306_Fill_Rect

# Draw a clipped integer Bresenham line.
Block SSD1306_Line Takes
    X0 : Signed_64
    Y0 : Signed_64
    X1 : Signed_64
    Y1 : Signed_64
    On : Boolean
    Produces Boolean
    Declares
        DX : Signed_64
        DY : Signed_64
        SX : Signed_64
        SY : Signed_64
        Error : Signed_64
        Twice_Error : Signed_64
    Implements
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        If (((X0 < -4096) Or (X0 > 4096)) Or ((X1 < -4096) Or (X1 > 4096)))
            SSD1306_Internal_Fail(1)
        End If
        If (((Y0 < -4096) Or (Y0 > 4096)) Or ((Y1 < -4096) Or (Y1 > 4096)))
            SSD1306_Internal_Fail(1)
        End If
        DX = X1 - X0
        If (DX < 0)
            DX = 0 - DX
            SX = -1
        Else
            SX = 1
        End If
        DY = Y1 - Y0
        If (DY < 0)
            DY = 0 - DY
            SY = -1
        Else
            SY = 1
        End If
        Error = DX - DY
        Loop
            If (((X0 >= 0) And (X0 < SSD1306_WIDTH)) And ((Y0 >= 0) And (Y0 < SSD1306_HEIGHT)))
                If (SSD1306_Pixel(X0, Y0, On) == False)
                    SSD1306_Internal_Fail(1)
                End If
            End If
            If ((X0 == X1) And (Y0 == Y1))
                Exit
            End If
            Twice_Error = Error * 2
            If (Twice_Error > (0 - DY))
                Error = Error - DY
                X0 = X0 + SX
            End If
            If (Twice_Error < DX)
                Error = Error + DX
                Y0 = Y0 + SY
            End If
        End Loop
        Give True
End SSD1306_Line

# Draw an unfilled rectangle with inclusive width/height interior dimensions.
Block SSD1306_Rect Takes
    X : Signed_64
    Y : Signed_64
    Width : Signed_64
    Height : Signed_64
    On : Boolean
    Produces Boolean
    Implements
        If (((Width <= 0) Or (Width > 128)) Or ((Height <= 0) Or (Height > 64)))
            SSD1306_Internal_Fail(1)
        End If
        If (((X < -128) Or (X > 128)) Or ((Y < -64) Or (Y > 64)))
            SSD1306_Internal_Fail(1)
        End If
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        If (SSD1306_Line(X, Y, X + Width - 1, Y, On) == False)
            SSD1306_Internal_Fail(1)
        End If
        If (SSD1306_Line(X, Y + Height - 1, X + Width - 1, Y + Height - 1, On) == False)
            SSD1306_Internal_Fail(1)
        End If
        If (SSD1306_Line(X, Y, X, Y + Height - 1, On) == False)
            SSD1306_Internal_Fail(1)
        End If
        Give SSD1306_Line(X + Width - 1, Y, X + Width - 1, Y + Height - 1, On)
End SSD1306_Rect

