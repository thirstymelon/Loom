Module SSD1306_Basic
Import RP2040
Import I2C
Import SSD1306
Import SSD1306_Graphics
Import SSD1306_Font
use RP2040
use I2C
use SSD1306
use SSD1306_Graphics
use SSD1306_Font

Block Main
    Declares
        OLED_I2C : I2C_Handle
    Implements
        RP2040_Init()
        OLED_I2C = I2C_Init(4, 5)
        SSD1306_Init(OLED_I2C)
        SSD1306_Clear()
        SSD1306_Rect(8, 8, 112, 48, True)
        SSD1306_Text(18, 24, "Hello Loom", True)
        SSD1306_Present()
End Main
