Module SSD1306_Font
Import SSD1306
use SSD1306

Block Global
    Declares
        SSD1306_FONT_DATA : Constant Unsigned_8 Array[475] = {
        0, 0, 0, 0, 0, 0, 0, 95, 0, 0, 0, 7, 0, 7, 0, 20, 127, 20, 127, 20, 36, 42, 127, 42, 18,
        35, 19, 8, 100, 98, 54, 73, 85, 34, 80, 0, 5, 3, 0, 0, 0, 28, 34, 65, 0, 0, 65, 34, 28, 0,
        20, 8, 62, 8, 20, 8, 8, 62, 8, 8, 0, 80, 48, 0, 0, 8, 8, 8, 8, 8, 0, 96, 96, 0, 0,
        32, 16, 8, 4, 2, 62, 81, 73, 69, 62, 0, 66, 127, 64, 0, 66, 97, 81, 73, 70, 33, 65, 69, 75, 49,
        24, 20, 18, 127, 16, 39, 69, 69, 69, 57, 60, 74, 73, 73, 48, 1, 113, 9, 5, 3, 54, 73, 73, 73, 54,
        6, 73, 73, 41, 30, 0, 54, 54, 0, 0, 0, 86, 54, 0, 0, 8, 20, 34, 65, 0, 20, 20, 20, 20, 20,
        0, 65, 34, 20, 8, 2, 1, 81, 9, 6, 50, 73, 121, 65, 62, 126, 17, 17, 17, 126, 127, 73, 73, 73, 54,
        62, 65, 65, 65, 34, 127, 65, 65, 34, 28, 127, 73, 73, 73, 65, 127, 9, 9, 9, 1, 62, 65, 73, 73, 122,
        127, 8, 8, 8, 127, 0, 65, 127, 65, 0, 32, 64, 65, 63, 1, 127, 8, 20, 34, 65, 127, 64, 64, 64, 64,
        127, 2, 12, 2, 127, 127, 4, 8, 16, 127, 62, 65, 65, 65, 62, 127, 9, 9, 9, 6, 62, 65, 81, 33, 94,
        127, 9, 25, 41, 70, 70, 73, 73, 73, 49, 1, 1, 127, 1, 1, 63, 64, 64, 64, 63, 31, 32, 64, 32, 31,
        63, 64, 56, 64, 63, 99, 20, 8, 20, 99, 7, 8, 112, 8, 7, 97, 81, 73, 69, 67, 0, 127, 65, 65, 0,
        2, 4, 8, 16, 32, 0, 65, 65, 127, 0, 4, 2, 1, 2, 4, 64, 64, 64, 64, 64, 0, 1, 2, 4, 0,
        32, 84, 84, 84, 120, 127, 72, 68, 68, 56, 56, 68, 68, 68, 32, 56, 68, 68, 72, 127, 56, 84, 84, 84, 24,
        8, 126, 9, 1, 2, 12, 82, 82, 82, 62, 127, 8, 4, 4, 120, 0, 68, 125, 64, 0, 32, 64, 68, 61, 0,
        127, 16, 40, 68, 0, 0, 65, 127, 64, 0, 124, 4, 24, 4, 120, 124, 8, 4, 4, 120, 56, 68, 68, 68, 56,
        124, 20, 20, 20, 8, 8, 20, 20, 24, 124, 124, 8, 4, 4, 8, 72, 84, 84, 84, 32, 4, 63, 68, 64, 32,
        60, 64, 64, 32, 124, 28, 32, 64, 32, 28, 60, 64, 48, 64, 60, 68, 40, 16, 40, 68, 12, 80, 80, 80, 60,
        68, 100, 84, 76, 68, 0, 8, 54, 65, 0, 0, 0, 127, 0, 0, 0, 65, 54, 8, 0, 8, 8, 42, 28, 8
        }
End Global

Block SSD1306_Font_Column Takes
    Code : Signed_64
    Column : Signed_64
    Produces Signed_64
    Implements
        If (((Code < 32) Or (Code > 126)) Or ((Column < 0) Or (Column > 4)))
            Give 0
        End If
        Give Cast[Signed_64](SSD1306_FONT_DATA[((Code - 32) * 5) + Column + 1])
End SSD1306_Font_Column

# Draw one printable ASCII character using the bundled 5x7 font.
Block SSD1306_Character Takes
    X : Signed_64
    Y : Signed_64
    Code : Signed_64
    On : Boolean
    Produces Boolean
    Declares
        Col : Signed_64
        Row : Signed_64
        Glyph : Signed_64
    Implements
        If ((Code < 32) Or (Code > 126))
            SSD1306_Internal_Fail(1)
        End If
        If (((X < -128) Or (X > 128)) Or ((Y < -64) Or (Y > 64)))
            SSD1306_Internal_Fail(1)
        End If
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        Col = 0
        Loop while (Col < 5)
            Glyph = SSD1306_Font_Column(Code, Col)
            Row = 0
            Loop while (Row < 7)
                If ((Glyph & (1 LSL Row)) != 0)
                    If (((X + Col >= 0) And (X + Col < SSD1306_WIDTH)) And ((Y + Row >= 0) And (Y + Row < SSD1306_HEIGHT)))
                        If (SSD1306_Pixel(X + Col, Y + Row, On) == False)
                            SSD1306_Internal_Fail(1)
                        End If
                    End If
                Else
                    If (((X + Col >= 0) And (X + Col < SSD1306_WIDTH)) And ((Y + Row >= 0) And (Y + Row < SSD1306_HEIGHT)))
                        If (SSD1306_Pixel(X + Col, Y + Row, False) == False)
                            SSD1306_Internal_Fail(1)
                        End If
                    End If
                End If
                Row = Row + 1
            End Loop
            Col = Col + 1
        End Loop
        Give True
End SSD1306_Character

# Draw text with 6-pixel character spacing. Supports printable ASCII (32..126).
Block SSD1306_Text Takes
    X : Signed_64
    Y : Signed_64
    Text : String
    On : Boolean
    Produces Boolean
    Declares
        Index : Signed_64
        Code : Signed_64
        Cursor : Signed_64
    Implements
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        If (((X < -128) Or (X > 128)) Or ((Y < -64) Or (Y > 64)))
            SSD1306_Internal_Fail(1)
        End If
        If (Text.Length > 128)
            SSD1306_Internal_Fail(1)
        End If
        Cursor = X
        Index = 1
        Loop while (Index <= Cast[Signed_64](Text.Length))
            Code = Cast[Signed_64](Text[Index])
            If ((Code < 32) Or (Code > 126))
                SSD1306_Internal_Fail(1)
            End If
            If (SSD1306_Character(Cursor, Y, Code, On) == False)
                SSD1306_Internal_Fail(1)
            End If
            Cursor = Cursor + 6
            Index = Index + 1
        End Loop
        Give True
End SSD1306_Text

