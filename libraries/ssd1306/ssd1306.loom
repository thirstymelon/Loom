Module SSD1306
Import I2C
use I2C

# SSD1306 128x64 I2C controller with a 1 KiB page-major framebuffer.
Block Global
    Declares
        SSD1306_WIDTH : Constant Signed_64 = 128
        SSD1306_HEIGHT : Constant Signed_64 = 64
        SSD1306_FRAME_BYTES : Constant Signed_64 = 1024
        SSD1306_DEFAULT_ADDRESS : Constant Signed_64 = 0x3C
        SSD1306_Bus : I2C_Handle
        SSD1306_Address : Signed_64 = 0x3C
        SSD1306_Initialized : Boolean = False
        SSD1306_Last_Error_Code : Signed_64 = 0
        SSD1306_Last_Error_Message : String = ""
        SSD1306_Framebuffer : Unsigned_8 Array[1024]
        SSD1306_Dirty : Boolean Array[8]
End Global

Block SSD1306_Internal_Fail Takes
    Code : Signed_64
    Implements
        SSD1306_Last_Error_Code = Code
        SSD1306_Last_Error_Message = "SSD1306: invalid state or drawing argument"
        Loop
        End Loop
End SSD1306_Internal_Fail

# Uses the provided initialized I2C bus and the common 0x3C panel address.
Block SSD1306_Init Takes
    Bus : I2C_Handle
    Declares
        Setup : Unsigned_8 Array[27] = {0x00, 0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40, 0x8D, 0x14, 0x20, 0x02, 0xA1, 0xC8, 0xDA, 0x12, 0x81, 0x7F, 0xD9, 0xF1, 0xDB, 0x40, 0xA4, 0xA6, 0x2E, 0xAF}
        I : Signed_64
        Presented : Boolean
    Implements
        SSD1306_Bus = Bus
        SSD1306_Address = SSD1306_DEFAULT_ADDRESS
        SSD1306_Initialized = False
        I2C_Write(SSD1306_Bus, SSD1306_Address, Slice(Setup))
        I = 1
        Loop while (I <= SSD1306_FRAME_BYTES)
            SSD1306_Framebuffer[I] = 0
            I = I + 1
        End Loop
        I = 1
        Loop while (I <= 8)
            SSD1306_Dirty[I] = True
            I = I + 1
        End Loop
        SSD1306_Initialized = True
        Presented = SSD1306_Present()
End SSD1306_Init

Block SSD1306_Is_Initialized Produces Boolean
    Implements
        Give SSD1306_Initialized
End SSD1306_Is_Initialized

# Set one framebuffer pixel. Out-of-range coordinates return False.
Block SSD1306_Pixel Takes
    X : Signed_64
    Y : Signed_64
    On : Boolean
    Produces Boolean
    Declares
        Index : Signed_64
        Mask : Signed_64
        Value : Signed_64
        Page : Signed_64
    Implements
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        If (((X < 0) Or (X >= SSD1306_WIDTH)) Or ((Y < 0) Or (Y >= SSD1306_HEIGHT)))
            SSD1306_Internal_Fail(1)
        End If
        Page = Y / 8
        Index = (Page * SSD1306_WIDTH) + X + 1
        Mask = 1 LSL (Y & 7)
        Value = Cast[Signed_64](SSD1306_Framebuffer[Index])
        If (On)
            Value = Value | Mask
        Else
            Value = Value & (~Mask)
        End If
        SSD1306_Framebuffer[Index] = Cast[Unsigned_8](Value)
        SSD1306_Dirty[Page + 1] = True
        Give True
End SSD1306_Pixel

# Clear only the local image. Call Present to send it to the panel.
Block SSD1306_Clear
    Produces Boolean
    Declares
        I : Signed_64
    Implements
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        I = 1
        Loop while (I <= SSD1306_FRAME_BYTES)
            SSD1306_Framebuffer[I] = 0
            I = I + 1
        End Loop
        I = 1
        Loop while (I <= 8)
            SSD1306_Dirty[I] = True
            I = I + 1
        End Loop
        Give True
End SSD1306_Clear

# Send only changed framebuffer pages to the panel.
Block SSD1306_Present
    Produces Boolean
    Declares
        Page : Signed_64
        Col : Signed_64
        Commands : Unsigned_8 Array[4]
        Data : Unsigned_8 Array[129]
    Implements
        If (SSD1306_Initialized == False)
            SSD1306_Internal_Fail(1)
        End If
        Page = 0
        Loop while (Page < 8)
            If (SSD1306_Dirty[Page + 1])
                Commands[1] = 0x00
                Commands[2] = Cast[Unsigned_8](0xB0 + Page)
                Commands[3] = 0x00
                Commands[4] = 0x10
                I2C_Write(SSD1306_Bus, SSD1306_Address, Slice(Commands))
                Data[1] = 0x40
                Col = 0
                Loop while (Col < SSD1306_WIDTH)
                    Data[Col + 2] = SSD1306_Framebuffer[(Page * SSD1306_WIDTH) + Col + 1]
                    Col = Col + 1
                End Loop
                I2C_Write(SSD1306_Bus, SSD1306_Address, Slice(Data))
                SSD1306_Dirty[Page + 1] = False
            End If
            Page = Page + 1
        End Loop
        Give True
End SSD1306_Present

Block SSD1306_Update
    Produces Boolean
    Implements
        Give SSD1306_Present()
End SSD1306_Update
