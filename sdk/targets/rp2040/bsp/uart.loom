Module UART

Import UART_Internal
use UART_Internal

Record UART_Handle
    Port : Signed_64
    TX_Pin : Signed_64
    RX_Pin : Signed_64
    Identity : Signed_64
End UART_Handle

Block Global
    Declares
        UART_Last_Error_Code : Signed_64 = 0
        UART_Last_Error_Message : String = ""
        UART0_TX_Pin : Signed_64 = -1
        UART0_RX_Pin : Signed_64 = -1
        UART1_TX_Pin : Signed_64 = -1
        UART1_RX_Pin : Signed_64 = -1
End Global

Block UART_Internal_Fail Takes
    Code : Signed_64
    Implements
        UART_Last_Error_Code = Code
        If (Code == -1)
            UART_Last_Error_Message = "UART: invalid handle, pins, or byte value"
        Else
            UART_Last_Error_Message = "UART: transmit FIFO timed out"
        End If
        Loop
        End Loop
End UART_Internal_Fail

Block UART_Internal_Validate_Handle Takes
    Handle : UART_Handle
    Implements
        If (((Handle.Identity != 1431191634) Or ((Handle.Port < 0) Or (Handle.Port > 1))) Or (UART_Internal.UART_Internal_Pins_Are_Valid(Handle.Port, Handle.TX_Pin, Handle.RX_Pin) == False))
            UART_Internal_Fail(-1)
        End If
        If (Handle.Port == 0)
            If ((Handle.TX_Pin != UART0_TX_Pin) Or (Handle.RX_Pin != UART0_RX_Pin))
                UART_Internal_Fail(-1)
            End If
        Else
            If ((Handle.TX_Pin != UART1_TX_Pin) Or (Handle.RX_Pin != UART1_RX_Pin))
                UART_Internal_Fail(-1)
            End If
        End If
End UART_Internal_Validate_Handle

# Selects UART0/UART1 from the pin pair and uses 115200 baud, 8-N-1.
Block UART_Init Takes
    TX_Pin : Signed_64
    RX_Pin : Signed_64
    Produces UART_Handle
    Declares
        Port : Signed_64
        Handle : UART_Handle
    Implements
        If (UART_Internal.UART_Internal_Pins_Are_Valid(0, TX_Pin, RX_Pin))
            Port = 0
        Else If (UART_Internal.UART_Internal_Pins_Are_Valid(1, TX_Pin, RX_Pin))
            Port = 1
        Else
            UART_Internal_Fail(-1)
        End If
        UART_Internal.UART_Init_Channel_Freq(Port, 115200, TX_Pin, RX_Pin, 125000000)
        Handle.Port = Port
        Handle.TX_Pin = TX_Pin
        Handle.RX_Pin = RX_Pin
        Handle.Identity = 1431191634
        If (Port == 0)
            UART0_TX_Pin = TX_Pin
            UART0_RX_Pin = RX_Pin
        Else
            UART1_TX_Pin = TX_Pin
            UART1_RX_Pin = RX_Pin
        End If
        UART_Last_Error_Code = 0
        UART_Last_Error_Message = ""
        Give Handle
End UART_Init

Block UART_Write Takes
    Handle : UART_Handle
    Text : String
    Declares
        Ok : Boolean
    Implements
        UART_Internal_Validate_Handle(Handle)
        Ok = UART_Internal.UART_Internal_Write_String(Handle.Port, Text)
        If (Ok == False)
            UART_Internal_Fail(-2)
        End If
End UART_Write

Block UART_Write_Byte Takes
    Handle : UART_Handle
    Value : Signed_64
    Declares
        Ok : Boolean
    Implements
        UART_Internal_Validate_Handle(Handle)
        If ((Value < 0) Or (Value > 255))
            UART_Internal_Fail(-1)
        End If
        Ok = UART_Internal.UART_Internal_Write_Byte(Handle.Port, Value)
        If (Ok == False)
            UART_Internal_Fail(-2)
        End If
End UART_Write_Byte

# This is a data-availability query, not an operation result.
Block UART_Byte_Available Takes
    Handle : UART_Handle
    Produces Boolean
    Implements
        UART_Internal_Validate_Handle(Handle)
        Give UART_Internal.UART_Is_Available_Ch(Handle.Port)
End UART_Byte_Available

# Nonblocking read: returns -1 when UART_Byte_Available is False.
Block UART_Read_Byte Takes
    Handle : UART_Handle
    Produces Signed_64
    Implements
        UART_Internal_Validate_Handle(Handle)
        Give UART_Internal.UART_Internal_Read_Byte(Handle.Port)
End UART_Read_Byte
