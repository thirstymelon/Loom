Module SPI

Import SPI_Internal
use SPI_Internal

Record SPI_Handle
    Controller : Signed_64
    SCK_Pin : Signed_64
    MOSI_Pin : Signed_64
    MISO_Pin : Signed_64
    Identity : Signed_64
End SPI_Handle

Block Global
    Declares
        SPI_Last_Error_Code : Signed_64 = 0
        SPI_Last_Error_Message : String = ""
        SPI0_SCK_Pin : Signed_64 = -1
        SPI0_MOSI_Pin : Signed_64 = -1
        SPI0_MISO_Pin : Signed_64 = -1
        SPI1_SCK_Pin : Signed_64 = -1
        SPI1_MOSI_Pin : Signed_64 = -1
        SPI1_MISO_Pin : Signed_64 = -1
End Global

Block SPI_Internal_Fail Takes
    Code : Signed_64
    Implements
        SPI_Last_Error_Code = Code
        If (Code == -1)
            SPI_Last_Error_Message = "SPI: invalid handle, pins, or byte value"
        Else
            SPI_Last_Error_Message = "SPI: transmit FIFO timed out"
        End If
        Loop
        End Loop
End SPI_Internal_Fail

Block SPI_Internal_Validate_Handle Takes
    Handle : SPI_Handle
    Implements
        If (((Handle.Identity != 1397771313) Or ((Handle.Controller < 0) Or (Handle.Controller > 1))) Or (SPI_Internal.SPI_Internal_Pin_Is_Valid(Handle.Controller, Handle.SCK_Pin, 0) == False))
            SPI_Internal_Fail(-1)
        End If
        If ((SPI_Internal.SPI_Internal_Pin_Is_Valid(Handle.Controller, Handle.MOSI_Pin, 1) == False) Or (SPI_Internal.SPI_Internal_Pin_Is_Valid(Handle.Controller, Handle.MISO_Pin, 2) == False))
            SPI_Internal_Fail(-1)
        End If
        If (Handle.Controller == 0)
            If (((Handle.SCK_Pin != SPI0_SCK_Pin) Or (Handle.MOSI_Pin != SPI0_MOSI_Pin)) Or (Handle.MISO_Pin != SPI0_MISO_Pin))
                SPI_Internal_Fail(-1)
            End If
        Else
            If (((Handle.SCK_Pin != SPI1_SCK_Pin) Or (Handle.MOSI_Pin != SPI1_MOSI_Pin)) Or (Handle.MISO_Pin != SPI1_MISO_Pin))
                SPI_Internal_Fail(-1)
            End If
        End If
End SPI_Internal_Validate_Handle

# Uses beginner defaults: 1 MHz, eight-bit words, SPI mode 0.
Block SPI_Init Takes
    SCK_Pin : Signed_64
    MOSI_Pin : Signed_64
    MISO_Pin : Signed_64
    Produces SPI_Handle
    Declares
        Bus : Signed_64
        Handle : SPI_Handle
    Implements
        If ((SPI_Internal.SPI_Internal_Pin_Is_Valid(0, SCK_Pin, 0) And SPI_Internal.SPI_Internal_Pin_Is_Valid(0, MOSI_Pin, 1)) And SPI_Internal.SPI_Internal_Pin_Is_Valid(0, MISO_Pin, 2))
            Bus = 0
        Else If ((SPI_Internal.SPI_Internal_Pin_Is_Valid(1, SCK_Pin, 0) And SPI_Internal.SPI_Internal_Pin_Is_Valid(1, MOSI_Pin, 1)) And SPI_Internal.SPI_Internal_Pin_Is_Valid(1, MISO_Pin, 2))
            Bus = 1
        Else
            SPI_Internal_Fail(-1)
        End If
        SPI_Internal.SPI_Init_Channel_Freq(Bus, 1000000, SCK_Pin, MOSI_Pin, MISO_Pin, 125000000)
        SPI_Internal.SPI_Set_Format(Bus, 8, 0, 0)
        Handle.Controller = Bus
        Handle.SCK_Pin = SCK_Pin
        Handle.MOSI_Pin = MOSI_Pin
        Handle.MISO_Pin = MISO_Pin
        Handle.Identity = 1397771313
        If (Bus == 0)
            SPI0_SCK_Pin = SCK_Pin
            SPI0_MOSI_Pin = MOSI_Pin
            SPI0_MISO_Pin = MISO_Pin
        Else
            SPI1_SCK_Pin = SCK_Pin
            SPI1_MOSI_Pin = MOSI_Pin
            SPI1_MISO_Pin = MISO_Pin
        End If
        SPI_Last_Error_Code = 0
        SPI_Last_Error_Message = ""
        Give Handle
End SPI_Init

Block SPI_Transfer_Byte Takes
    Handle : SPI_Handle
    Out_Byte : Signed_64
    Produces Signed_64
    Declares
        Value : Signed_64
    Implements
        SPI_Internal_Validate_Handle(Handle)
        If ((Out_Byte < 0) Or (Out_Byte > 255))
            SPI_Internal_Fail(-1)
        End If
        Value = SPI_Internal.SPI_Transfer_Byte_Ch(Handle.Controller, Out_Byte)
        If (Value < 0)
            SPI_Internal_Fail(-2)
        End If
        Give Value
End SPI_Transfer_Byte

Block SPI_Write_Byte Takes
    Handle : SPI_Handle
    Out_Byte : Signed_64
    Implements
        SPI_Transfer_Byte(Handle, Out_Byte)
End SPI_Write_Byte

Block SPI_Read_Byte Takes
    Handle : SPI_Handle
    Produces Signed_64
    Implements
        Give SPI_Transfer_Byte(Handle, 255)
End SPI_Read_Byte

Block SPI_Write Takes
    Handle : SPI_Handle
    Bytes : Unsigned_8 Slice
    Declares
        Result : Signed_64
    Implements
        SPI_Internal_Validate_Handle(Handle)
        Result = SPI_Internal.SPI_Write_Slice(Handle.Controller, Bytes)
        If (Result != 0)
            SPI_Internal_Fail(Result)
        End If
End SPI_Write

Block SPI_Read Takes
    Handle : SPI_Handle
    Bytes : Unsigned_8 Slice
    Declares
        Result : Signed_64
    Implements
        SPI_Internal_Validate_Handle(Handle)
        Result = SPI_Internal.SPI_Read_Slice(Handle.Controller, Bytes, 255)
        If (Result != 0)
            SPI_Internal_Fail(Result)
        End If
End SPI_Read

Block SPI_Transfer Takes
    Handle : SPI_Handle
    Transmit : Unsigned_8 Slice
    Receive : Unsigned_8 Slice
    Declares
        Result : Signed_64
    Implements
        SPI_Internal_Validate_Handle(Handle)
        Result = SPI_Internal.SPI_Transfer_Slices(Handle.Controller, Transmit, Receive)
        If (Result != 0)
            SPI_Internal_Fail(Result)
        End If
End SPI_Transfer
