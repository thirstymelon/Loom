Module I2C

Import I2C_Internal
use I2C_Internal

# A configured I2C controller. Keep the handle returned by I2C_Init and pass it
# to every device library that uses this bus.
Record I2C_Handle
    Controller : Signed_64
    SDA_Pin : Signed_64
    SCL_Pin : Signed_64
    Identity : Signed_64
End I2C_Handle

Block Global
    Declares
        I2C_100_KHZ : Constant Signed_64 = 100000
        I2C_ERROR_INVALID_ARGUMENT : Constant Signed_64 = -1
        I2C_ERROR_TIMEOUT : Constant Signed_64 = -2
        I2C_ERROR_NACK : Constant Signed_64 = -3
        I2C_ERROR_CONTROLLER : Constant Signed_64 = -4
        I2C_Last_Error_Code : Signed_64 = 0
        I2C_Last_Error_Message : String = ""
        I2C0_SDA_Pin : Signed_64 = -1
        I2C0_SCL_Pin : Signed_64 = -1
        I2C1_SDA_Pin : Signed_64 = -1
        I2C1_SCL_Pin : Signed_64 = -1
End Global

Block I2C_Internal_Fail Takes
    Code : Signed_64
    Implements
        I2C_Last_Error_Code = Code
        If (Code == I2C_ERROR_INVALID_ARGUMENT)
            I2C_Last_Error_Message = "I2C: invalid handle, pins, address, or call order"
        Else If (Code == I2C_ERROR_TIMEOUT)
            I2C_Last_Error_Message = "I2C: controller timed out"
        Else If (Code == I2C_ERROR_NACK)
            I2C_Last_Error_Message = "I2C: device did not acknowledge"
        Else
            I2C_Last_Error_Message = "I2C: controller failure"
        End If
        Loop
        End Loop
End I2C_Internal_Fail

Block I2C_Internal_Validate_Handle Takes
    Handle : I2C_Handle
    Implements
        If (((Handle.Identity != 1228084035) Or ((Handle.Controller < 0) Or (Handle.Controller > 1))) Or (I2C_Internal.I2C_Internal_Pins_Are_Valid(Handle.Controller, Handle.SDA_Pin, Handle.SCL_Pin) == False))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        If (Handle.Controller == 0)
            If ((Handle.SDA_Pin != I2C0_SDA_Pin) Or (Handle.SCL_Pin != I2C0_SCL_Pin))
                I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
            End If
        Else
            If ((Handle.SDA_Pin != I2C1_SDA_Pin) Or (Handle.SCL_Pin != I2C1_SCL_Pin))
                I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
            End If
        End If
End I2C_Internal_Validate_Handle

# Selects the correct controller from SDA/SCL and uses the beginner default of 100 kHz.
Block I2C_Init Takes
    SDA_Pin : Signed_64
    SCL_Pin : Signed_64
    Produces I2C_Handle
    Declares
        Bus : Signed_64
        Handle : I2C_Handle
    Implements
        If ((SCL_Pin != (SDA_Pin + 1)) Or (SDA_Pin < 0))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        If ((SDA_Pin <= 28) And ((SDA_Pin Mod 4) == 0))
            Bus = 0
        Else If ((SDA_Pin <= 26) And (SDA_Pin >= 2) And ((SDA_Pin Mod 4) == 2))
            Bus = 1
        Else
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        If (I2C_Internal.I2C_Init_Channel_Freq(Bus, I2C_100_KHZ, SDA_Pin, SCL_Pin, 125000000) == False)
            I2C_Internal_Fail(I2C_ERROR_CONTROLLER)
        End If
        Handle.Controller = Bus
        Handle.SDA_Pin = SDA_Pin
        Handle.SCL_Pin = SCL_Pin
        Handle.Identity = 1228084035
        If (Bus == 0)
            I2C0_SDA_Pin = SDA_Pin
            I2C0_SCL_Pin = SCL_Pin
        Else
            I2C1_SDA_Pin = SDA_Pin
            I2C1_SCL_Pin = SCL_Pin
        End If
        I2C_Last_Error_Code = 0
        I2C_Last_Error_Message = ""
        Give Handle
End I2C_Init

Block I2C_Write Takes
    Handle : I2C_Handle
    Device_Address : Signed_64
    Bytes : Unsigned_8 Slice
    Declares
        Result : Signed_64
    Implements
        I2C_Internal_Validate_Handle(Handle)
        If ((Device_Address < 8) Or (Device_Address > 119))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        Result = I2C_Internal.I2C_Write_Slice(Handle.Controller, Device_Address, Bytes, False)
        If (Result != 0)
            I2C_Internal_Fail(Result)
        End If
End I2C_Write

Block I2C_Read Takes
    Handle : I2C_Handle
    Device_Address : Signed_64
    Bytes : Unsigned_8 Slice
    Declares
        Result : Signed_64
    Implements
        I2C_Internal_Validate_Handle(Handle)
        If ((Device_Address < 8) Or (Device_Address > 119))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        Result = I2C_Internal.I2C_Read_Slice(Handle.Controller, Device_Address, Bytes, False)
        If (Result != 0)
            I2C_Internal_Fail(Result)
        End If
End I2C_Read

Block I2C_Write_Register Takes
    Handle : I2C_Handle
    Device_Address : Signed_64
    Register_Index : Signed_64
    Value : Signed_64
    Declares
        Result : Signed_64
    Implements
        I2C_Internal_Validate_Handle(Handle)
        If (((Device_Address < 8) Or (Device_Address > 119)) Or ((Register_Index < 0) Or (Register_Index > 255)))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        If ((Value < 0) Or (Value > 255))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        Result = I2C_Internal.I2C_Internal_Write_Register_8(Handle.Controller, Device_Address, Register_Index, Value)
        If (Result != 0)
            I2C_Internal_Fail(Result)
        End If
End I2C_Write_Register

Block I2C_Read_Register Takes
    Handle : I2C_Handle
    Device_Address : Signed_64
    Register_Index : Signed_64
    Produces Signed_64
    Declares
        Result : Signed_64
    Implements
        I2C_Internal_Validate_Handle(Handle)
        If (((Device_Address < 8) Or (Device_Address > 119)) Or ((Register_Index < 0) Or (Register_Index > 255)))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        Result = I2C_Internal.I2C_Internal_Read_Register_8(Handle.Controller, Device_Address, Register_Index)
        If (Result < 0)
            I2C_Internal_Fail(Result)
        End If
        Give Result
End I2C_Read_Register

# Atomic register-window read: sends the register pointer without STOP, then
# reads the requested bytes with a repeated START and a final STOP.
Block I2C_Read_Register_Block Takes
    Handle : I2C_Handle
    Device_Address : Signed_64
    Start_Register : Signed_64
    Bytes : Unsigned_8 Slice
    Declares
        Register : Unsigned_8 Array[1]
        Result : Signed_64
    Implements
        I2C_Internal_Validate_Handle(Handle)
        If (((Device_Address < 8) Or (Device_Address > 119)) Or ((Start_Register < 0) Or (Start_Register > 255)))
            I2C_Internal_Fail(I2C_ERROR_INVALID_ARGUMENT)
        End If
        If (Bytes.Length > 0)
            Register[1] = Cast[Unsigned_8](Start_Register)
            Result = I2C_Internal.I2C_Write_Slice(Handle.Controller, Device_Address, Slice(Register), True)
            If (Result != 0)
                I2C_Internal_Fail(Result)
            End If
            Result = I2C_Internal.I2C_Read_Slice(Handle.Controller, Device_Address, Bytes, False)
            If (Result != 0)
                I2C_Internal_Fail(Result)
            End If
        End If
End I2C_Read_Register_Block
