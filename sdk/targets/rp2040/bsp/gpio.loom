Module GPIO

Import System
use System

Block Global
    Declares
        PIN_INPUT  : Constant Signed_64 = 0
        PIN_OUTPUT : Constant Signed_64 = 1

        PULL_NONE  : Constant Signed_64 = 0
        PULL_UP    : Constant Signed_64 = 1
        PULL_DOWN  : Constant Signed_64 = 2

        # Pin Peripheral Functions (IO_BANK0 GPIOx_CTRL: FUNCSEL)
        GPIO_FUNC_XIP  : Constant Signed_64 = 0
        GPIO_FUNC_SPI  : Constant Signed_64 = 1
        GPIO_FUNC_UART : Constant Signed_64 = 2
        GPIO_FUNC_I2C  : Constant Signed_64 = 3
        GPIO_FUNC_PWM  : Constant Signed_64 = 4
        GPIO_FUNC_SIO  : Constant Signed_64 = 5
        GPIO_FUNC_PIO0 : Constant Signed_64 = 6
        GPIO_FUNC_PIO1 : Constant Signed_64 = 7
        GPIO_FUNC_GPCK : Constant Signed_64 = 8
        GPIO_FUNC_USB  : Constant Signed_64 = 9
        GPIO_FUNC_NULL : Constant Signed_64 = 31

        # Drive Strengths
        DRIVE_2MA  : Constant Signed_64 = 0
        DRIVE_4MA  : Constant Signed_64 = 1
        DRIVE_8MA  : Constant Signed_64 = 2
        DRIVE_12MA : Constant Signed_64 = 3

        # GPIO Interrupt Event Flags
        GPIO_IRQ_LEVEL_LOW  : Constant Signed_64 = 1
        GPIO_IRQ_LEVEL_HIGH : Constant Signed_64 = 2
        GPIO_IRQ_EDGE_FALL  : Constant Signed_64 = 4
        GPIO_IRQ_EDGE_RISE  : Constant Signed_64 = 8
End Global

Block Set_Function Takes
    Pin : Signed_64
    Func : Signed_64
    Declares
        Ctrl_Addr : Signed_64
        Pad_Addr : Signed_64
        Pad_Val : Unsigned_32
    Implements
        # 1. Clear output enable & out in SIO if was SIO
        # 2. Set FUNCSEL in IO_BANK0 (GPIO_CTRL = 0x40014004 + Pin * 8)
        Ctrl_Addr = 0x40014004 + (Pin * 8)
        Vol_Write_32(Ctrl_Addr, Func & 0x1F)

        # 3. Ensure pad is enabled for digital (clear isolation, enable input/output)
        Pad_Addr = 0x4001C004 + (Pin * 4)
        Pad_Val = Vol_Read_32(Pad_Addr)
        # Clear OD (output disable bit 7 = 128), enable IE (input enable bit 6 = 64)
        Pad_Val = (Pad_Val & 0xFFFFFF7F) | 64
        Vol_Write_32(Pad_Addr, Pad_Val)
End Set_Function

Block Init_Pin Takes
    Pin : Signed_64
    Implements
        Set_Function(Pin, GPIO_FUNC_SIO)
End Init_Pin

Block Set_Direction Takes
    Pin : Signed_64
    Direction : Signed_64
    Declares
        Pin_Mask : Signed_64
    Implements
        Pin_Mask = 1 LSL Pin
        If (Direction == 1)
            # SIO_GPIO_OE_SET: 0xD0000024
            Vol_Write_32(0xD0000024, Pin_Mask)
        Else
            # SIO_GPIO_OE_CLR: 0xD0000028
            Vol_Write_32(0xD0000028, Pin_Mask)
        End If
End Set_Direction

Block Set_High Takes
    Pin : Signed_64
    Declares
        Pin_Mask : Signed_64
    Implements
        Pin_Mask = 1 LSL Pin
        # SIO_GPIO_OUT_SET (0xD0000014)
        Vol_Write_32(0xD0000014, Pin_Mask)
End Set_High

Block Set_Low Takes
    Pin : Signed_64
    Declares
        Pin_Mask : Signed_64
    Implements
        Pin_Mask = 1 LSL Pin
        # SIO_GPIO_OUT_CLR (0xD0000018)
        Vol_Write_32(0xD0000018, Pin_Mask)
End Set_Low

Block Toggle Takes
    Pin : Signed_64
    Declares
        Pin_Mask : Signed_64
    Implements
        Pin_Mask = 1 LSL Pin
        # SIO_GPIO_OUT_XOR (0xD000001C)
        Vol_Write_32(0xD000001C, Pin_Mask)
End Toggle

Block Put Takes
    Pin : Signed_64
    Value : Boolean
    Implements
        If (Value == True)
            Set_High(Pin)
        Else
            Set_Low(Pin)
        End If
End Put

Block Read_Pin Takes
    Pin : Signed_64
    Produces Signed_64
    Declares
        Pin_Mask : Signed_64
        Values : Unsigned_32
    Implements
        Pin_Mask = 1 LSL Pin
        Values = Vol_Read_32(0xD0000004)
        If ((Cast[Signed_64](Values) & Pin_Mask) != 0)
            Give 1
        Else
            Give 0
        End If
End Read_Pin

Block Set_Pull Takes
    Pin : Signed_64
    Pull : Signed_64
    Declares
        Pad_Addr : Signed_64
        Val : Unsigned_32
    Implements
        # PADS_BANK0_BASE = 0x4001C000, GPIO0 offset = 0x04
        Pad_Addr = 0x4001C004 + (Pin * 4)
        Val = Vol_Read_32(Pad_Addr)
        # Clear PUE (bit 3 = 8) and PDE (bit 2 = 4): 0xC = 12
        Val = Val & 0xFFFFFFF3
        If (Pull == 1)
            Val = Val | 8     # PULL_UP
        Else If (Pull == 2)
            Val = Val | 4     # PULL_DOWN
        End If
        Vol_Write_32(Pad_Addr, Val)
End Set_Pull

Block Set_Drive_Strength Takes
    Pin : Signed_64
    Strength : Signed_64
    Declares
        Pad_Addr : Signed_64
        Val : Unsigned_32
    Implements
        Pad_Addr = 0x4001C004 + (Pin * 4)
        Val = Vol_Read_32(Pad_Addr)
        # DRIVE is bits 5:4 (mask 0x30 = 48)
        Val = (Val & 0xFFFFFFCF) | (Cast[Unsigned_32](Strength & 3) LSL 4)
        Vol_Write_32(Pad_Addr, Val)
End Set_Drive_Strength

Block Set_Slew_Rate Takes
    Pin : Signed_64
    Fast : Boolean
    Declares
        Pad_Addr : Signed_64
        Val : Unsigned_32
    Implements
        Pad_Addr = 0x4001C004 + (Pin * 4)
        Val = Vol_Read_32(Pad_Addr)
        # SLEWFAST is bit 0
        If (Fast == True)
            Val = Val | 1
        Else
            Val = Val & 0xFFFFFFFE
        End If
        Vol_Write_32(Pad_Addr, Val)
End Set_Slew_Rate

Block Set_Schmitt_Trigger Takes
    Pin : Signed_64
    Enabled : Boolean
    Declares
        Pad_Addr : Signed_64
        Val : Unsigned_32
    Implements
        Pad_Addr = 0x4001C004 + (Pin * 4)
        Val = Vol_Read_32(Pad_Addr)
        # SCHMITT is bit 1 (2)
        If (Enabled == True)
            Val = Val | 2
        Else
            Val = Val & 0xFFFFFFFD
        End If
        Vol_Write_32(Pad_Addr, Val)
End Set_Schmitt_Trigger

# Multi-pin Port Operations
Block Read_All_Pins
    Produces Unsigned_32
    Implements
        Give Vol_Read_32(0xD0000004)
End Read_All_Pins

Block Set_Pins_Mask Takes
    Mask : Unsigned_32
    Implements
        Vol_Write_32(0xD0000014, Mask)
End Set_Pins_Mask

Block Clear_Pins_Mask Takes
    Mask : Unsigned_32
    Implements
        Vol_Write_32(0xD0000018, Mask)
End Clear_Pins_Mask

Block XOR_Pins_Mask Takes
    Mask : Unsigned_32
    Implements
        Vol_Write_32(0xD000001C, Mask)
End XOR_Pins_Mask

Block Write_Pins_Mask Takes
    Mask : Unsigned_32
    Values : Unsigned_32
    Declares
        Current : Unsigned_32
        New_Val : Unsigned_32
    Implements
        Current = Vol_Read_32(0xD0000010)
        New_Val = (Current & (~Mask)) | (Values & Mask)
        Vol_Write_32(0xD0000010, New_Val)
End Write_Pins_Mask

# Interrupts on GPIO Pins
Block Enable_Pin_Interrupt_Core Takes
    Core : Signed_64
    Pin : Signed_64
    Events : Signed_64
    Declares
        Reg_Idx : Signed_64
        Bit_Shift : Signed_64
        Addr : Signed_64
        Base_Offset : Signed_64
        Current : Unsigned_32
    Implements
        # PROC0_INTE at 0x100, PROC1_INTE at 0x110
        If (Core == 1)
            Base_Offset = 0x40014110
        Else
            Base_Offset = 0x40014100
        End If
        Reg_Idx = Pin / 8
        Bit_Shift = (Pin Mod 8) * 4
        Addr = Base_Offset + (Reg_Idx * 4)
        Current = Vol_Read_32(Addr)
        Current = Current | (Cast[Unsigned_32](Events & 0x0F) LSL Bit_Shift)
        Vol_Write_32(Addr, Current)
End Enable_Pin_Interrupt_Core

Block Enable_Pin_Interrupt Takes
    Pin : Signed_64
    Events : Signed_64
    Implements
        Enable_Pin_Interrupt_Core(0, Pin, Events)
End Enable_Pin_Interrupt

Block Clear_Pin_Interrupt Takes
    Pin : Signed_64
    Events : Signed_64
    Declares
        Reg_Idx : Signed_64
        Bit_Shift : Signed_64
        Addr : Signed_64
    Implements
        # INTR is at IO_BANK0_BASE + 0x0F0 + (Pin / 8) * 4
        Reg_Idx = Pin / 8
        Bit_Shift = (Pin Mod 8) * 4
        Addr = 0x400140F0 + (Reg_Idx * 4)
        Vol_Write_32(Addr, Cast[Unsigned_32](Events & 0x0F) LSL Bit_Shift)
End Clear_Pin_Interrupt

Block Get_Pin_Interrupt_Status_Core Takes
    Core : Signed_64
    Pin : Signed_64
    Produces Signed_64
    Declares
        Reg_Idx : Signed_64
        Bit_Shift : Signed_64
        Addr : Signed_64
        Base_Offset : Signed_64
        Status : Unsigned_32
    Implements
        # PROC0_INTS at 0x120, PROC1_INTS at 0x130
        If (Core == 1)
            Base_Offset = 0x40014130
        Else
            Base_Offset = 0x40014120
        End If
        Reg_Idx = Pin / 8
        Bit_Shift = (Pin Mod 8) * 4
        Addr = Base_Offset + (Reg_Idx * 4)
        Status = Vol_Read_32(Addr)
        Give Cast[Signed_64]((Status LSR Bit_Shift) & 0x0F)
End Get_Pin_Interrupt_Status_Core

Block Get_Pin_Interrupt_Status Takes
    Pin : Signed_64
    Produces Signed_64
    Implements
        Give Get_Pin_Interrupt_Status_Core(0, Pin)
End Get_Pin_Interrupt_Status
