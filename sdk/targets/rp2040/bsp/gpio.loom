Module GPIO

Import GPIO_Internal
use GPIO_Internal

Block Global
    Declares
        GPIO_PULL_NONE  : Constant Signed_64 = 0
        GPIO_PULL_UP    : Constant Signed_64 = 1
        GPIO_PULL_DOWN  : Constant Signed_64 = 2
        GPIO_Last_Error_Code : Signed_64 = 0
        GPIO_Last_Error_Message : String = ""
End Global

Block GPIO_Internal_Fail Takes
    Code : Signed_64
    Implements
        GPIO_Last_Error_Code = Code
        If (Code == -1)
            GPIO_Last_Error_Message = "GPIO: invalid pin"
        Else If (Code == -2)
            GPIO_Last_Error_Message = "GPIO: invalid pull setting"
        Else
            GPIO_Last_Error_Message = "GPIO: invalid interrupt event mask"
        End If
        Loop
        End Loop
End GPIO_Internal_Fail

# GPIO pins are numbered 0 through 29 on the RP2040.
Block GPIO_Is_Valid_Pin Takes
    Pin : Signed_64
    Produces Boolean
    Implements
        Give GPIO_Internal.GPIO_Internal_Pin_Is_Valid(Pin)
End GPIO_Is_Valid_Pin

# Configure a pin as a digital input with no pull, pull-up, or pull-down.
Block GPIO_Init_Input Takes
    Pin : Signed_64
    Pull : Signed_64
    Declares
        Ok : Boolean
    Implements
        If (GPIO_Is_Valid_Pin(Pin) == False)
            GPIO_Internal_Fail(-1)
        End If
        If ((Pull < GPIO_PULL_NONE) Or (Pull > GPIO_PULL_DOWN))
            GPIO_Internal_Fail(-2)
        End If
        Ok = GPIO_Internal.GPIO_Internal_Init_Input(Pin, Pull)
        If (Ok == False)
            GPIO_Internal_Fail(-2)
        End If
End GPIO_Init_Input

# Configure an output and choose its initial level before enabling the driver.
Block GPIO_Init_Output Takes
    Pin : Signed_64
    Initial_High : Boolean
    Declares
        Ok : Boolean
    Implements
        Ok = GPIO_Internal.GPIO_Internal_Init_Output(Pin, Initial_High)
        If (Ok == False)
            GPIO_Internal_Fail(-1)
        End If
End GPIO_Init_Output

Block GPIO_Write Takes
    Pin : Signed_64
    Value : Boolean
    Declares
        Ok : Boolean
    Implements
        Ok = GPIO_Internal.GPIO_Internal_Write(Pin, Value)
        If (Ok == False)
            GPIO_Internal_Fail(-1)
        End If
End GPIO_Write

# Returns 0 or 1. Invalid pins record a diagnostic and stop.
Block GPIO_Read Takes
    Pin : Signed_64
    Produces Signed_64
    Implements
        If (GPIO_Is_Valid_Pin(Pin) == False)
            GPIO_Internal_Fail(-1)
        End If
        Give GPIO_Internal.Read_Pin(Pin)
End GPIO_Read

Block GPIO_Toggle Takes
    Pin : Signed_64
    Declares
        Ok : Boolean
    Implements
        Ok = GPIO_Internal.GPIO_Internal_Toggle(Pin)
        If (Ok == False)
            GPIO_Internal_Fail(-1)
        End If
End GPIO_Toggle

Block GPIO_Set_Pull Takes
    Pin : Signed_64
    Pull : Signed_64
    Implements
        If (GPIO_Is_Valid_Pin(Pin) == False)
            GPIO_Internal_Fail(-1)
        End If
        If ((Pull < GPIO_PULL_NONE) Or (Pull > GPIO_PULL_DOWN))
            GPIO_Internal_Fail(-2)
        End If
        GPIO_Internal.Set_Pull(Pin, Pull)
        GPIO_Last_Error_Code = 0
        GPIO_Last_Error_Message = ""
End GPIO_Set_Pull

# Events are ORs of the GPIO_IRQ_* flags above. Call from the configured IRQ handler.
Block GPIO_Enable_Interrupt Takes
    Pin : Signed_64
    Events : Signed_64
    Implements
        If (GPIO_Is_Valid_Pin(Pin) == False)
            GPIO_Internal_Fail(-1)
        End If
        If ((Events <= 0) Or ((Events & 15) != Events))
            GPIO_Internal_Fail(-3)
        End If
        GPIO_Internal.Enable_Pin_Interrupt(Pin, Events)
        GPIO_Last_Error_Code = 0
        GPIO_Last_Error_Message = ""
End GPIO_Enable_Interrupt

Block GPIO_Interrupt_Status Takes
    Pin : Signed_64
    Produces Signed_64
    Implements
        If (GPIO_Is_Valid_Pin(Pin) == False)
            GPIO_Internal_Fail(-1)
        End If
        Give GPIO_Internal.Get_Pin_Interrupt_Status(Pin)
End GPIO_Interrupt_Status

Block GPIO_Clear_Interrupt Takes
    Pin : Signed_64
    Events : Signed_64
    Implements
        If (GPIO_Is_Valid_Pin(Pin) == False)
            GPIO_Internal_Fail(-1)
        End If
        If ((Events <= 0) Or ((Events & 15) != Events))
            GPIO_Internal_Fail(-3)
        End If
        GPIO_Internal.Clear_Pin_Interrupt(Pin, Events)
        GPIO_Last_Error_Code = 0
        GPIO_Last_Error_Message = ""
End GPIO_Clear_Interrupt
