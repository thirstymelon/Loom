Module System

Block Global
Declares
    SYS_CLOCK_12MHZ  : Constant Signed_64 = 12000000
    SYS_CLOCK_125MHZ : Constant Signed_64 = 125000000
End Global

Block Unreset_Peripherals Takes
    Mask : Unsigned_32
Declares
    Done : Unsigned_32
    Timeout : Signed_64
Implements
    Vol_Write_32(0x4000F000, Mask)
    Timeout = 10000
    Done = Vol_Read_32(0x4000C008)
    Loop Until (((Done & Mask) == Mask) Or (Timeout <= 0))
        Done = Vol_Read_32(0x4000C008)
        Timeout = Timeout - 1
    End Loop
End Unreset_Peripherals

Block System_Init
Declares
    Status : Unsigned_32
    Done : Unsigned_32
    Timeout : Signed_64
    Selected : Unsigned_32
Implements
    # 1. Start the 12 MHz External Crystal Oscillator (XOSC)
    Status = Vol_Read_32(0x40024004)
    If ((Status & 0x80000000) == 0)
        Vol_Write_32(0x4002400C, 47)         # Startup delay ~1ms (47 * 256 / 12MHz)
        Vol_Write_32(0x40024000, 0xFABAA0)   # 0xFAB enable password + 0xAA0 1-15MHz range
        Status = Vol_Read_32(0x40024004)
        Timeout = 100000
        Loop Until (((Status & 0x80000000) != 0) Or (Timeout <= 0))
            Status = Vol_Read_32(0x40024004)
            Timeout = Timeout - 1
        End Loop

        # If XOSC is stable, switch clk_ref and set exact 1.000000 MHz tick
        If ((Status & 0x80000000) != 0)
            # Switch clk_ref to XOSC (source 2 = xosc_clksrc at 12.000 MHz)
            Vol_Write_32(0x40008030, 2)
            Timeout = 10000
            Selected = Vol_Read_32(0x40008038)
            Loop Until (((Selected & 4) != 0) Or (Timeout <= 0))
                Selected = Vol_Read_32(0x40008038)
                Timeout = Timeout - 1
            End Loop

            # Watchdog tick: 12 cycles of 12.000 MHz clk_ref = exact 1.000000 MHz tick (512 | 12 = 524)
            Vol_Write_32(0x4005802C, 524)
        End If
    End If

    # 2. Unreset IO_BANK0 (bit 5), PADS_BANK0 (bit 8), and TIMER (bit 21)
    # Total mask = 32 + 256 + 2097152 = 2097440 (0x200120)
    Unreset_Peripherals(Cast[Unsigned_32](2097440))
End System_Init

Block System_Reset
Implements
    # Trigger watchdog software reset
    Vol_Write_32(0x40058000, 0x00000000)
End System_Reset

