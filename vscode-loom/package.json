{
  "name": "loom-language-support",
  "displayName": "Loom Language Support",
  "description": "Loom language support for Visual Studio Code with syntax highlighting, auto-indentation, snippets, intelligent code suggestions, navigation, and compiler diagnostics.",
  "version": "1.5.0",
  "publisher": "loom-language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thirstymelon/Loom.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "loom",
    "llvm",
    "language",
    "systems",
    "rp2040",
    "embedded",
    "baremetal",
    "pio"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:loom",
    "onCommand:loom.checkFile",
    "onCommand:loom.formatDocument",
    "onCommand:loom.restartLanguageServer",
    "onCommand:loom.setCompilerPath",
    "onCommand:loom.showOutput",
    "onCommand:loom.build",
    "onCommand:loom.clean",
    "onCommand:loom.run",
    "onCommand:loom.test",
    "onCommand:loom.fetch",
    "onCommand:loom.flash",
    "onCommand:loom.monitor",
    "onCommand:loom.switchToolchain",
    "onCommand:loom.refreshWorkspaceIndex",
    "workspaceContains:config.toml",
    "workspaceContains:**/*.loom"
  ],
  "contributes": {
    "languages": [
      {
        "id": "loom",
        "aliases": [
          "Loom",
          "loom"
        ],
        "extensions": [
          ".loom"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/Loom_Logo.png",
          "dark": "./icons/Loom_Logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "loom",
        "scopeName": "source.loom",
        "path": "./syntaxes/loom.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "loom",
        "scopes": {
          "namespace": ["entity.name.namespace.loom"],
          "type": ["support.type.primitive.loom"],
          "class": ["entity.name.type.record.loom"],
          "function": ["entity.name.function.loom"],
          "parameter": ["variable.parameter.loom"],
          "variable": ["variable.other.loom"],
          "property": ["variable.other.property.loom"],
          "keyword": ["keyword.control.loom"],
          "number": ["constant.numeric.integer.loom"],
          "string": ["string.quoted.double.loom"],
          "comment": ["comment.line.number-sign.loom"]
        }
      }
    ],
    "snippets": [
      {
        "language": "loom",
        "path": "./snippets/loom.json"
      }
    ],
    "commands": [
      {
        "command": "loom.checkFile",
        "title": "Loom: Check Current File"
      },
      {
        "command": "loom.formatDocument",
        "title": "Loom: Format Document"
      },
      {
        "command": "loom.restartLanguageServer",
        "title": "Loom: Restart Language Server"
      },
      {
        "command": "loom.setCompilerPath",
        "title": "Loom: Select loomc Compiler"
      },
      {
        "command": "loom.showOutput",
        "title": "Loom: Show Output"
      },
      {
        "command": "loom.build",
        "title": "Loom: Build Workspace"
      },
      {
        "command": "loom.clean",
        "title": "Loom: Clean Workspace"
      },
      {
        "command": "loom.run",
        "title": "Loom: Build and Run Workspace"
      },
      {
        "command": "loom.test",
        "title": "Loom: Run Tests"
      },
      {
        "command": "loom.fetch",
        "title": "Loom: Fetch Dependencies"
      },
      {
        "command": "loom.flash",
        "title": "Loom: Flash Firmware (RP2040)"
      },
      {
        "command": "loom.monitor",
        "title": "Loom: Open Serial Monitor"
      },
      {
        "command": "loom.switchToolchain",
        "title": "Loom: Switch Active Toolchain"
      },
      {
        "command": "loom.refreshWorkspaceIndex",
        "title": "Loom: Refresh Workspace Index"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "loom.run", "when": "editorLangId == loom", "group": "navigation@1" },
        { "command": "loom.flash", "when": "editorLangId == loom", "group": "navigation@2" },
        { "command": "loom.build", "when": "editorLangId == loom", "group": "navigation@3" },
        { "command": "loom.checkFile", "when": "editorLangId == loom", "group": "navigation@4" }
      ],
      "editor/context": [
        { "command": "loom.checkFile", "when": "editorLangId == loom", "group": "loom@1" },
        { "command": "loom.formatDocument", "when": "editorLangId == loom", "group": "loom@2" },
        { "command": "loom.build", "when": "editorLangId == loom", "group": "loom@3" },
        { "command": "loom.run", "when": "editorLangId == loom", "group": "loom@4" },
        { "command": "loom.flash", "when": "editorLangId == loom", "group": "loom@5" },
        { "command": "loom.monitor", "when": "editorLangId == loom", "group": "loom@6" }
      ]
    },
    "configuration": {
      "title": "Loom",
      "properties": {
        "loom.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to loomc. If blank, detects the project toolchain and checks ~/.loom/toolchains and the standard macOS Loom installation paths before the workspace bin/ directory and PATH."
        },
        "loom.lint.run": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "default": "onType",
          "description": "When to run compiler-backed diagnostics."
        },
        "loom.lint.delay": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "Debounce delay in milliseconds for on-type checking."
        },
        "loom.format.indentSize": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per indentation level used by the built-in fallback indenter when `loom fmt` is unavailable."
        },
        "loom.toolPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the Loom workspace tool. If blank, checks /usr/bin/loom, the workspace bin/ directory, then PATH."
        }
      }
    },
    "configurationDefaults": {
      "[loom]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnType": true,
        "editor.formatOnSave": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "matchingDocuments"
      }
    }
  },
  "scripts": {
    "test": "node ./test/diagnostics.js && node ./test/language.js && node ./test/lsp.js && node ./test/client.js && node ./test/smoke.js",
    "package": "vsce package --no-dependencies -o Loom-1.4.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.26.1"
  },
  "icon": "./icons/Loom_Logo.png"
}
