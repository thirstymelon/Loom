{
  "Module declaration": {
    "prefix": "module",
    "body": [
      "Module ${1:ModuleName}",
      "",
      "$0"
    ],
    "description": "Required module header declaration at the top of every Loom file"
  },
  "Block with result": {
    "prefix": "block",
    "body": [
      "Block ${1:Name}",
      "    Takes",
      "        ${2:Value} : ${3:Signed_32}",
      "    Produces ${4:Signed_32}",
      "    Implements",
      "        Give ${2:Value}",
      "End ${1:Name}"
    ],
    "description": "Function with a parameter and result"
  },
  "Procedure": {
    "prefix": "procedure",
    "body": [
      "Block ${1:Name}",
      "    Implements",
      "        $0",
      "End ${1:Name}"
    ],
    "description": "Parameterless procedure"
  },
  "Invoke block": {
    "prefix": "invoke",
    "body": [
      "${1:BlockName}($0)"
    ],
    "description": "Direct function or procedure invocation (Loom calls blocks directly without 'Call')"
  },
  "If": {
    "prefix": "if",
    "body": [
      "If ${1:condition}",
      "    $0",
      "End If"
    ],
    "description": "Conditional block"
  },
  "Else If": {
    "prefix": "elseif",
    "body": [
      "Else If ${1:condition}",
      "    $0"
    ],
    "description": "Chained conditional branch"
  },
  "Loop": {
    "prefix": "loop",
    "body": [
      "Loop",
      "    $0",
      "End Loop"
    ],
    "description": "Infinite loop"
  },
  "Loop Until": {
    "prefix": "loopuntil",
    "body": [
      "Loop Until ${1:condition}",
      "    $0",
      "End Loop"
    ],
    "description": "Conditional loop"
  },
  "Record declaration": {
    "prefix": "record",
    "body": [
      "Record ${1:RecordName}",
      "    ${2:Field} : ${3:Signed_32}",
      "End ${1:RecordName}"
    ],
    "description": "Structured data record"
  },
  "Enum declaration": {
    "prefix": "enum",
    "body": [
      "Enum ${1:EnumName} : ${2:Unsigned_8}",
      "    ${3:Variant} = ${4:0}",
      "End ${1:EnumName}"
    ],
    "description": "Enumeration with backing integer type"
  },
  "Write text": {
    "prefix": "write",
    "body": [
      "Write(${1:Value})$0"
    ],
    "description": "Print a value or string literal"
  },
  "Local declaration": {
    "prefix": "declares",
    "body": [
      "Declares",
      "    ${1:Name} : ${2:Signed_32}"
    ],
    "description": "Declare local variables"
  },
  "Ensure statement": {
    "prefix": "ensureone",
    "body": [
      "Ensure { ${1:Write(\"Clean up resources\")} }"
    ],
    "description": "Single-line deterministic LIFO cleanup statement executed on scope exit"
  },
  "Pointer declaration": {
    "prefix": "pointer",
    "body": [
      "${1:Ptr} : ${2:Signed_32} Pointer = Address(${3:Value})"
    ],
    "description": "Explicit pointer declaration with Address of variable"
  },
  "Array declaration": {
    "prefix": "array",
    "body": [
      "${1:Buffer} : ${2:Signed_32} Array[${3:4}]"
    ],
    "description": "Fixed-size contiguous stack array"
  },
  "Slice declaration": {
    "prefix": "slice",
    "body": [
      "${1:View} : ${2:Signed_32} Slice = Slice(${3:Buffer})"
    ],
    "description": "Fat pointer slice view over memory or array"
  },
  "Cast expression": {
    "prefix": "cast",
    "body": [
      "Cast[${1:Target_Type}](${2:Expression})"
    ],
    "description": "Explicit type conversion with compile-time safety checks"
  },
  "Extern Block": {
    "prefix": "extern",
    "body": [
      "Extern Block ${1:SymbolName}",
      "    Takes",
      "        ${2:Arg} : ${3:String}",
      "    Produces ${4:Signed_32}",
      "End ${1:SymbolName}"
    ],
    "description": "C Foreign Function Interface declaration"
  },
  "Concise routine": {
    "prefix": "concise",
    "body": [
      "Block ${1:Name} Takes",
      "    ${2:A} : ${3:Signed_32}",
      "Produces (${4:$2 + 1})",
      "End ${1:Name}"
    ],
    "description": "Single-line concise routine with inferred return type"
  },
  "Loop While": {
    "prefix": "loopwhile",
    "body": [
      "Loop while ${1:condition}",
      "    $0",
      "End Loop"
    ],
    "description": "Conditional while loop"
  },
  "Match statement": {
    "prefix": "match",
    "body": [
      "Match ${1:Expression}",
      "    When ${2:Pattern}:",
      "        $0",
      "    Default:",
      "        ",
      "End Match"
    ],
    "description": "Pattern matching block with When cases and Default fallback"
  },
  "Record literal": {
    "prefix": "reclit",
    "body": [
      "${1:RecordName}{ ${2:Field}: ${3:value} }"
    ],
    "description": "Inline record initialization literal"
  },
  "Use module": {
    "prefix": "use",
    "body": [
      "use ${1:ModuleName}"
    ],
    "description": "Unqualified module import directive"
  },
  "Type Cast As": {
    "prefix": "as",
    "body": [
      "${1:Expression} as ${2:Type}"
    ],
    "description": "Explicit type cast"
  },
  "Try Expression": {
    "prefix": "try",
    "body": [
      "try ${1:Expression}"
    ],
    "description": "Propagate error from fallible expression with Ensure cleanup unwinding"
  },
  "Ensure Multi-Line": {
    "prefix": "ensure",
    "body": [
      "Ensure {",
      "    ${1:CleanupStatement}",
      "}"
    ],
    "description": "Multi-line cleanup block executed on scope exit"
  },
  "Test Block": {
    "prefix": "test",
    "body": [
      "Test \"${1:test description}\"",
      "    Implements",
      "        $0",
      "End Test"
    ],
    "description": "Executable unit or integration test block"
  },
  "Packed Record": {
    "prefix": "packed",
    "body": [
      "Packed Record ${1:Name} Align ${2:1}",
      "    ${3:Field} : ${4:Type}",
      "End ${1:Name}"
    ],
    "description": "Packed record with explicit byte alignment"
  },
  "Spawn task": {
    "prefix": "spawn",
    "body": [
      "${1:Handle} : Task_Handle = Spawn ${2:Worker}(${3:Argument})"
    ],
    "description": "Spawn an asynchronous task and keep its handle"
  },
  "Join task": {
    "prefix": "join",
    "body": [
      "${1:Result} = Join ${2:Handle}"
    ],
    "description": "Wait for task completion and read its result"
  },
  "Vector declaration": {
    "prefix": "vector",
    "body": [
      "${1:Values} : ${2:Signed_32} Vector[${3:8}]"
    ],
    "description": "Growable typed vector"
  },
  "Text buffer": {
    "prefix": "textbuf",
    "body": [
      "${1:Buffer} : Text[${2:128}]"
    ],
    "description": "Dynamic Text buffer with a starting capacity"
  },
  "HMap declaration": {
    "prefix": "hmap",
    "body": [
      "${1:Lookup} : ${2:Signed_32} HMap[${3:String} : ${4:Signed_32}]"
    ],
    "description": "Hash map keyed by the first type with values of the second"
  },
  "Tuple result": {
    "prefix": "tuplereturn",
    "body": [
      "Block ${1:Name} Takes",
      "    ${2:Value} : ${3:Signed_32}",
      "Produces (${3:Signed_32}, ${4:Boolean})",
      "Implements",
      "    Give (${2:Value}, True)",
      "End ${1:Name}"
    ],
    "description": "Block that returns two values"
  },
  "Tuple unpack": {
    "prefix": "unpack",
    "body": [
      "${1:First}, ${2:Second} = ${3:Calc}()"
    ],
    "description": "Unpack a multi-value result"
  },
  "Error union result": {
    "prefix": "producesor",
    "body": [
      "Produces ${1:Signed_32} or ${2:Error}"
    ],
    "description": "Return a value or an error type"
  },
  "Constant declaration": {
    "prefix": "constant",
    "body": [
      "${1:Name} : Constant ${2:Signed_32} = ${3:0}"
    ],
    "description": "Declare an immutable value"
  },
  "Sub-slice": {
    "prefix": "subslice",
    "body": [
      "${1:View} : ${2:Signed_32} Slice = ${3:Items}[${4:1} .. ${5:Length}]"
    ],
    "description": "Non-owning view over part of a vector, array, or text"
  },
  "Raw pointer": {
    "prefix": "rawptr",
    "body": [
      "${1:Ptr} : ${2:Signed_32} Pointer = Address(${3:Value})"
    ],
    "description": "Explicit raw pointer to an existing value"
  },
  "Heap allocation": {
    "prefix": "allocate",
    "body": [
      "${1:Ptr} : ${2:Signed_32} Pointer = Allocate(${3:4})"
    ],
    "description": "Allocate a heap block; pair it with Release"
  },
  "For-in collection loop": {
    "prefix": "forin",
    "body": [
      "Loop ${1:Item} in ${2:Collection}",
      "    $0",
      "End Loop"
    ],
    "description": "Iterate through items in a collection"
  },
  "For-in range loop": {
    "prefix": "forrange",
    "body": [
      "Loop ${1:I} in ${2:1} .. ${3:10}",
      "    $0",
      "End Loop"
    ],
    "description": "Iterate through an integer range"
  },
  "Closure expression": {
    "prefix": "closure",
    "body": [
      "(${1:X} : ${2:Signed_64}) => ${3:Expr}"
    ],
    "description": "Inline anonymous lambda closure"
  },
  "Record with Drop destructor": {
    "prefix": "recorddrop",
    "body": [
      "Record ${1:Buffer}",
      "    ${2:Ptr} : ${3:Signed_32} Pointer",
      "Drop",
      "    If ${2:Ptr} != Null",
      "        Release(${2:Ptr})",
      "    End If",
      "End ${1:Buffer}"
    ],
    "description": "Record with RAII Drop cleanup block"
  },
  "Match case with guard": {
    "prefix": "whenguard",
    "body": [
      "When ${1:Pattern} where ${2:Condition}:",
      "    $0"
    ],
    "description": "Pattern match case with a condition guard"
  },
  "Match default case": {
    "prefix": "default",
    "body": [
      "default:",
      "    $0"
    ],
    "description": "Default catch-all branch for Match statement"
  }
}
