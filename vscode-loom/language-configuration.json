{
  "comments": {
    "lineComment": "#",
    "additionalLineComment": "//"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "surroundingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:Block\\b.*|Record\\b.*|Enum\\b.*|Extern\\s+Block\\b.*|Takes\\s*$|Declares\\s*$|Implements\\s*$|Produces\\s*$|If\\b.*|Else\\b.*|Loop\\b.*|Match\\b.*|When\\b.*:\\s*$|Else:\\s*$|Ensure(?:\\s*\\{)?)(?:\\s*(?:#|//).*)?$",
    "decreaseIndentPattern": "^\\s*(?:End\\b.*|Else\\b.*|When\\b.*:\\s*$|Else:\\s*|Declares\\s*$|Implements\\s*$|Produces\\s*$)(?:\\s*(?:#|//).*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:Block\\b.*|Record\\b.*|Enum\\b.*|Extern\\s+Block\\b.*|Takes\\s*$|Declares\\s*$|Implements\\s*$|Produces\\s*$|If\\b.*|Else\\b.*|Loop\\b.*|Match\\b.*|When\\b.*:\\s*$|Else:\\s*$|Ensure(?:\\s*\\{)?)(?:\\s*(?:#|//).*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*End\\s+.*$",
      "action": {
        "indent": "none"
      }
    }
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*(?:Block|Record|Enum|If|Loop|Match|Extern\\s+Block|#region)\\b",
      "end": "^\\s*(?:End|#endregion)\\b"
    }
  }
}
